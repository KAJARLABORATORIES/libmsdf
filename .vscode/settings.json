{
  "files.exclude": {
    "**/.git": true,
    "**/.svn": true,
    "**/.hg": true,
    "**/.DS_Store": true,
    "**/Thumbs.db": true,

    "**/bin": true,
    "**/obj": true,
  },
  "explorer.fileNesting.enabled": true,
  "explorer.fileNesting.patterns": {
    "*.slnx": "*.props,.editorconfig",
    "*.csproj": "*.props,.editorconfig"
  },
  "dotnet.defaultSolution": "osu-framework-msdf.slnx"
}
